PORT=3000
FRONTEND_URL=http://localhost:5173,http://localhost:5174
MONG0_URL=mongodb://localhost:27017/prayer
JWT_SECRET=replace-with-a-long-random-secret

# Admin account, created on boot when BOTH are set. Nothing is seeded without
# them — there is deliberately no default, since a default committed here would
# be public.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Brevo sends over HTTPS, so it works on hosts that block SMTP ports.
# Takes precedence over the SMTP settings below when set.
BREVO_API_KEY=

# SMTP (for account verification emails).
# If left empty, codes are logged to the console instead of being sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Prayer App <no-reply@prayer.app>"
