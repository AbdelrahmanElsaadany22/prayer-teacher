# Copy to .env before running `docker compose up --build`.

# Required — any long random string.
JWT_SECRET=change-me-to-something-long-and-random

# Where the browser reaches the API and the app. The defaults match the ports
# published in docker-compose.yml.
VITE_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# Admin account, created on boot when BOTH are set. Leave blank and no admin
# is seeded — there is no built-in default, by design.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional — avatar uploads fail without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — email transport. Leave both blank and verification codes are
# printed to the api container's logs instead of being sent.
# Brevo (HTTPS, works anywhere) takes precedence over SMTP when set.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
